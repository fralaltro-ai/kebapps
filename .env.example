# ==============================================================================
# KEBAPPS LOCAL - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copia questo file in `.env.local` prima dell'avvio:
#   cp .env.example .env.local
#
# Per emulazione locale Cloudflare Workers:
#   npm run setup:env:local   (genera .dev.vars a partire da .env.local)
#
# I valori predefiniti qui sotto avviano l'app in "Modalita Casa / Zero-Cost":
# nessuna carta di credito e nessun account Google Cloud richiesti.
# ==============================================================================

# --- MODALITA 1: CASA / ZERO-COST (PREDEFINITA, 0 EUR) ------------------------
# Con "1", i proxy /api/shops e /api/geocode-search servono le fixture locali
# e /map non effettua chiamate Google a pagamento.
NEXT_PUBLIC_DISABLE_PAID_APIS="1"
DISABLE_PAID_APIS="1"

# --- MODALITA 2: MAPPA LIVE PERSONALE (BYOK - BRING YOUR OWN KEYS) ------------
# Lascia vuote queste variabili in Modalita Casa / Zero-Cost.
# Per attivare la mappa Google live su tua istanza personale:
# 1. Imposta NEXT_PUBLIC_DISABLE_PAID_APIS="0" e DISABLE_PAID_APIS="0"
# 2. Chiave Frontend: ristretta per HTTP Referrer al tuo dominio/localhost + sole Maps JS API e Places UI Kit
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Solo sviluppo/test locale: "DEMO_MAP_ID" e' bloccato in produzione (impostare un Map ID reale da Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# 3. Chiave Backend (SOLO SERVER, mai prefisso NEXT_PUBLIC_): ristretta a Places API (New) + Geocoding API
GOOGLE_PLACES_BACKEND_KEY=""

# --- CLOUDFLARE TURNSTILE (Anti-Bot per /api/shops e /api/geocode-search) ------
# Chiavi di test pubbliche ufficiali Cloudflare (valide per sviluppo locale, sempre "PASS"):
# In produzione vanno sostituite con le chiavi reali del widget Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- CONFIGURAZIONE APP, TITOLARE GDPR & CONTATTI ------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ENABLE_PWA_DEV="false"

# Identita' reale del Titolare del trattamento per istanza pubblica (Art. 13(1)(a) GDPR)
# OBBLIGATORIO in produzione: nome/cognome reali + citta'/provincia in LOCATION (es. "Milano (MI), Italia"). Non lasciare vuoto o generico su kebapps.app.
NEXT_PUBLIC_DATA_CONTROLLER_NAME=""
NEXT_PUBLIC_DATA_CONTROLLER_LOCATION="Italia"

# Contatto supporto & privacy ufficiale
NEXT_PUBLIC_SUPPORT_EMAIL="support@kebapps.app"

# Token opzionale di verifica Google Search Console (meta tag google-site-verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# URL pubblico del repository (opzionale: se compilato, abilita il link nel Profilo)
NEXT_PUBLIC_REPOSITORY_URL=""
