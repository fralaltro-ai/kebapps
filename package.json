{
  "name": "kebapps",
  "version": "2.0.0",
  "private": false,
  "license": "MIT",
  "description": "PWA 100% local-first per esplorare kebab shop e gestire Diario personale e Wishlist sul proprio dispositivo.",
  "author": "KebApps <support@kebapps.app>",
  "homepage": "https://kebapps.app",
  "keywords": [
    "kebab",
    "pwa",
    "local-first",
    "nextjs",
    "indexeddb",
    "offline-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fralaltro-ai/kebapps.git"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/build.mjs",
    "build:cf": "npx @opennextjs/cloudflare build && npx @opennextjs/cloudflare populateCache local",
    "dev:cf": "wrangler dev",
    "setup:env": "cp .env.local .dev.vars",
    "setup:env:local": "node scripts/cf-local.mjs vars",
    "build:cf:local": "node scripts/cf-local.mjs build",
    "deploy:cf": "node scripts/cf-deploy-guard.mjs && npx @opennextjs/cloudflare deploy",
    "start": "next start",
    "lint": "npx eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "npx tsc --noEmit",
    "predev": "node scripts/generate-docs.mjs",
    "prebuild": "node scripts/generate-docs.mjs",
    "prebuild:cf": "node scripts/generate-docs.mjs",
    "verify:compliance": "node scripts/verify-compliance.mjs --repo-only",
    "verify:compliance:repo": "node scripts/verify-compliance.mjs --repo-only",
    "precommit": "npm run lint && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@react-google-maps/api": "^2.20.8",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "wrangler": "^4.163.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "glob": "^14.0.6",
    "minimatch": "^11.0.8",
    "postcss-selector-parser": "^6.1.6",
    "undici": "^7.30.2"
  }
}
